# ==============================================================================
# LogSetu — Environment Configuration Template
# Problem Statement: SIH26156 (NTRO)
# Copy this file to .env before starting the backend:
#   cp .env.example .env
# ==============================================================================

# ── AI Model Integrations (Optional) ─────────────────────────────────────────
# If keys are omitted, LogSetu automatically runs in 100% Air-Gapped Local Mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Cryptographic Hash-Chain Configuration ───────────────────────────────────
# Number of log events between Ed25519-signed checkpoints (default: 10 for demo)
CHECKPOINT_INTERVAL=10

# ── Format Drift Watchdog ───────────────────────────────────────────────────
# Rolling window of recent events to calculate parse success rate
DRIFT_WINDOW_SIZE=100
# Threshold below which an alert is triggered and re-mapping proposed (0.90 = 90%)
DRIFT_THRESHOLD=0.90

# ── Tiered Routing Configuration ─────────────────────────────────────────────
# Minimum severity for real-time Tier 1 SIEM forwarding (info, low, medium, high, critical)
TIER1_SEVERITY=high

# ── Alerting Webhook ─────────────────────────────────────────────────────────
# Destination URL for HTTP POST webhook alerts (leave empty to log to console only)
WEBHOOK_URL=http://localhost:9000/webhook

# ── Anomaly Detection ────────────────────────────────────────────────────────
# Isolation Forest contamination / threshold parameter
ANOMALY_THRESHOLD=0.85
ANOMALY_TRAINING_SIZE=50

# ── External Services (Optional / Standalone defaults to False) ──────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
